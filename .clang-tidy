# Phoenix C++ static analysis.
#
# Deliberately narrow. Every check enabled here is one that, when it fires on
# this codebase, names a defect a reviewer would also call a defect. Checks
# that mostly produce style arguments are off, because a gate that cries wolf
# gets suppressed wholesale, and a suppressed gate catches nothing.
#
# Not enabled, with reasons rather than silence:
#
#   readability-identifier-naming  O3DE naming (m_ members, PascalCase methods,
#                                  AZ_ macros) would need a full option block to
#                                  express. Expressed wrongly it would rename
#                                  half the tree; expressed partially it would
#                                  fight the engine's own headers. .clang-format
#                                  already carries the mechanical house style.
#   cppcoreguidelines-*            Assumes a codebase that owns its memory model.
#                                  Phoenix uses AZ::SystemAllocator, AZStd
#                                  containers and intrusive component lifetimes,
#                                  so these fire constantly on correct code.
#   google-*, llvm-*, fuchsia-*    Other organisations' house styles.
#   modernize-use-trailing-return-type  A formatting preference, not a defect.
#   bugprone-easily-swappable-parameters  Fires on nearly every (float, float).
#
# Running it: clang-tidy needs a compilation database. O3DE generates
# compile_commands.json when the project is configured against a registered
# engine, which this repository cannot do on its own (see
# docs/tdd/08-quality-gates.md). Until a build machine exists this file is a
# declaration that is applied by anyone who has one, not a gate CI runs.
# tests/Unit/test_cpp_tooling.py checks that it stays parseable and that the
# checks named here are ones the installed clang-tidy actually knows, so it
# cannot rot into a list of typos.

Checks: >
  -*,
  bugprone-argument-comment,
  bugprone-assert-side-effect,
  bugprone-bool-pointer-implicit-conversion,
  bugprone-copy-constructor-init,
  bugprone-dangling-handle,
  bugprone-fold-init-type,
  bugprone-forward-declaration-namespace,
  bugprone-inaccurate-erase,
  bugprone-incorrect-roundings,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-macro-repeated-side-effects,
  bugprone-misplaced-widening-cast,
  bugprone-move-forwarding-reference,
  bugprone-multiple-statement-macro,
  bugprone-parent-virtual-call,
  bugprone-posix-return,
  bugprone-sizeof-container,
  bugprone-sizeof-expression,
  bugprone-string-constructor,
  bugprone-string-integer-assignment,
  bugprone-suspicious-enum-usage,
  bugprone-suspicious-memset-usage,
  bugprone-suspicious-missing-comma,
  bugprone-suspicious-semicolon,
  bugprone-swapped-arguments,
  bugprone-terminating-continue,
  bugprone-too-small-loop-variable,
  bugprone-undefined-memory-manipulation,
  bugprone-undelegated-constructor,
  bugprone-unhandled-self-assignment,
  bugprone-unused-raii,
  bugprone-unused-return-value,
  bugprone-use-after-move,
  bugprone-virtual-near-miss,
  misc-definitions-in-headers,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-static-assert,
  misc-unconventional-assign-operator,
  misc-uniqueptr-reset-release,
  misc-unused-alias-decls,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-override,
  performance-faster-string-find,
  performance-for-range-copy,
  performance-implicit-conversion-in-loop,
  performance-inefficient-algorithm,
  performance-inefficient-string-concatenation,
  performance-inefficient-vector-operation,
  performance-move-const-arg,
  performance-move-constructor-init,
  performance-no-automatic-move,
  performance-trivially-destructible,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  readability-const-return-type,
  readability-delete-null-pointer,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  readability-redundant-control-flow,
  readability-redundant-string-cstr,
  readability-redundant-string-init,
  readability-string-compare

# Every enabled check is an error. A warning nobody has to fix is a warning
# nobody fixes; the narrowness above is what makes this affordable.
WarningsAsErrors: '*'

# Engine and third-party headers are not ours to fix, and diagnostics raised
# inside them would drown the ones raised in Phoenix code.
HeaderFilterRegex: '.*(gems|project)/.*/(Include|Source)/Phoenix/.*'

FormatStyle: file
