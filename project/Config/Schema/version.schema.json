{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Phoenix Product Version",
    "description": "Shape of project/Config/version.json. Agreement with Phoenix/Core/PhoenixVersion.h is a cross-file relation; tools/validation/validate_versions.py enforces it.",
    "type": "object",
    "required": ["product", "major", "minor", "patch"],
    "properties": {
        "$comment": { "type": "string" },
        "product": { "type": "string", "minLength": 1 },
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "patch": { "type": "integer", "minimum": 0 }
    },
    "additionalProperties": false
}
