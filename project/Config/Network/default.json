{
    "$comment": "Public multiplayer is gated; the architecture is built from the start. See docs/tdd/04-multiplayer.md and 90-source-reconciliation.md C1.",
    "mode": "disabled_until_multiplayer_gate",
    "serverAuthoritative": true,
